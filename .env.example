# DEV ENVIRONMENT
# Application configuration
TZ=Europe/Copenhagen

# Database configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Worker configuration
ATS_TOKEN=INSERT_TOKEN_HERE
# ATS_URL=http://api:8000
# ATS_URL=http://localhost:8000
ATS_CAPABILITIES=

ATS_WORKQUEUE_OVERRIDE=WORKQUEUE_ID

# Test configuration
# HTTP_PORT=
# HTTPS_PORT=
# SSL_CERT_PATH=

# Development configration
LOCAL_DEVELOPMENT=true

# DBConnection string to desired server
DBConnectionString=Driver=INSERT_CONN_STRING_HERE

# ---- Dataaftaler desktop settings ----
# Base directory for input/output files (overview Excel + run logs go in BASE_DIR/Output).
# Defaults to the repository root if unset.
# BASE_DIR=C:\Users\<bruger>\Dataaftaler

# DB-backed error emails are OFF by default on the desktop. Set to true only for
# headless/Automation Server runs where RPAConnection constants are reachable.
SEND_ERROR_EMAILS=false